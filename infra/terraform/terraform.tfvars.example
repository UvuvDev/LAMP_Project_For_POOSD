# Copy to terraform.tfvars and edit. Never commit the real file.

project_id  = "my-gcp-project"
region      = "us-central1"
zone        = "us-central1-a"
name_prefix = "lamp"
environment = "dev"

machine_type      = "e2-small"
boot_image        = "debian-cloud/debian-12"
boot_disk_size_gb = 20

ssh_user             = "deploy"
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH down to your own address: curl -s ifconfig.me
allowed_ssh_cidrs = ["203.0.113.10/32"]
allowed_web_cidrs = ["0.0.0.0/0"]

labels = {
  owner = "platform-team"
}
