[lamp]
${instance_name} ansible_host=${public_ip}

[lamp:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_private_key_path}
ansible_python_interpreter=/usr/bin/python3
gcp_project=${project_id}
gcp_zone=${zone}
