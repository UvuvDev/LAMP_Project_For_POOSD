<?php
// {{ ansible_managed }}
declare(strict_types=1);

$config = require '{{ app_config_dir }}/db.php';

$dbStatus = 'unknown';
$dbVersion = '-';
$visits = [];

try {
    $pdo = new PDO($config['dsn'], $config['user'], $config['password'], $config['options']);
    $dbVersion = (string) $pdo->query('SELECT VERSION()')->fetchColumn();

    $insert = $pdo->prepare('INSERT INTO visits (ip, user_agent) VALUES (:ip, :ua)');
    $insert->execute([
        ':ip' => $_SERVER['REMOTE_ADDR'] ?? 'unknown',
        ':ua' => substr((string) ($_SERVER['HTTP_USER_AGENT'] ?? ''), 0, 255),
    ]);

    $visits = $pdo->query('SELECT id, ip, created_at FROM visits ORDER BY id DESC LIMIT 5')->fetchAll();
    $dbStatus = 'connected';
} catch (Throwable $e) {
    // Details go to the error log, never to the browser.
    error_log('DB error: ' . $e->getMessage());
    $dbStatus = 'unavailable';
}

$esc = static fn (string $v): string => htmlspecialchars($v, ENT_QUOTES, 'UTF-8');
?>
