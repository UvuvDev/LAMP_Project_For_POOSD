# {{ ansible_managed }}
<VirtualHost *:80>
    ServerName {{ app_server_name }}
{% for alias in app_server_aliases %}
    ServerAlias {{ alias }}
{% endfor %}
    ServerAdmin {{ apache_server_admin }}

    DocumentRoot {{ app_docroot }}
    DirectoryIndex index.php index.html

{% if tls_enabled | bool %}
    # Send everything but the ACME challenge to the TLS vhost that certbot
    # created. Owning the redirect here keeps it across re-runs.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
{% endif %}

    <Directory {{ app_docroot }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
        # Hand the Authorization header (API bearer tokens) through to PHP-FPM.
        CGIPassAuth On
    </Directory>

    # PHP requests are proxied to the FPM pool over its unix socket.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:{{ php_fpm_socket }}|fcgi://localhost"
    </FilesMatch>

    # Only files that exist under the document root can be handed to PHP.
    <FilesMatch "\.(php|phar)$">
        <If "! -f %{REQUEST_FILENAME}">
            Require all denied
        </If>
    </FilesMatch>

    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/*  "access plus 1 month"
        ExpiresByType text/css "access plus 1 week"
        ExpiresByType application/javascript "access plus 1 week"
    </IfModule>

    ErrorLog  ${APACHE_LOG_DIR}/{{ app_name }}-error.log
    CustomLog ${APACHE_LOG_DIR}/{{ app_name }}-access.log {{ apache_log_format }}
    LogLevel warn
</VirtualHost>
